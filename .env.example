# Optional. Copy to .env (git-ignored) to change defaults. Olympus needs no API key:
# employees run as subagents in your Claude Code session, on its own login.

# OLYMPUS_PORT=4800
# OLYMPUS_WORKSPACE=~/Olympus
# OLYMPUS_MAX_ACTIVATIONS=3          # agent runs per employee, per company run
# OLYMPUS_MAX_RUN_ACTIVATIONS=8      # agent runs per company run, in total
# OLYMPUS_MAX_CONCURRENCY=4          # employees working at the same time
# OLYMPUS_HOST_TIMEOUT_MIN=20        # unreported work goes back to the inbox after this
# OLYMPUS_ALLOWED_ORIGINS=http://localhost:5173   # only for the Vite dev server
