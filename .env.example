# Optional settings for the Olympus daemon. Olympus needs no API key: employees run as subagents
# in your Claude Code session, on its own login.
# Set these in your shell, or save this file somewhere and point OLYMPUS_ENV_FILE at it.
# (In a local checkout of the repo, a .env file at the repo root is read too; it is git-ignored.)
# Settings changed on the dashboard are saved and win over these defaults.

# OLYMPUS_PORT=4800
# OLYMPUS_WORKSPACE=~/Olympus
# OLYMPUS_MODE=claude-code                # or "simulated": scripted employees, no model calls
# OLYMPUS_MAX_CONCURRENCY=4               # employees working at the same time
# OLYMPUS_MAX_ACTIVATIONS=12              # agent runs per employee, per project
# OLYMPUS_MAX_PROJECT_ACTIVATIONS=60      # agent runs per project, in total
# OLYMPUS_HOST_TIMEOUT_MIN=20             # unreported work goes back to the inbox after this
# OLYMPUS_COMPANY_NAME=Olympus
# OLYMPUS_ALLOWED_ORIGINS=http://localhost:5173   # only for the Vite dev server
