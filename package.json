{
  "name": "olympus",
  "version": "0.0.1",
  "private": true,
  "description": "Olympus: an AI tech company plugin for Claude Code (Phase 0 spike)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/shared",
    "packages/daemon",
    "packages/dashboard",
    "packages/cli",
    "packages/mcp"
  ],
  "scripts": {
    "build": "node scripts/gen-plugin-content.mjs && npm run build -w @olympus/daemon && npm run build -w @olympus/dashboard && node scripts/build-plugin.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test -w @olympus/daemon",
    "daemon": "node packages/daemon/dist/main.js",
    "dev:daemon": "npm run dev -w @olympus/daemon",
    "dev:dashboard": "npm run dev -w @olympus/dashboard",
    "olympus": "node plugin/dist/olympus.mjs",
    "validate:plugin": "claude plugin validate ./plugin",
    "gen:plugin": "node scripts/gen-plugin-content.mjs",
    "smoke": "node scripts/smoke-mcp.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
